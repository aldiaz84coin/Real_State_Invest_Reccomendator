# ---- Base de datos (gratuita por defecto: SQLite en volumen de Fly) ----
DATABASE_URL=sqlite:////data/investment.db

# ---- Idealista (unica via oficial de anuncios; se solicita en developers.idealista.com) ----
IDEALISTA_API_KEY=
IDEALISTA_API_SECRET=

# ---- Respaldo NO oficial via RapidAPI (opcional, desactivado sin clave) ----
# Revendedores que extraen datos de los portales: quedan fuera del criterio de
# "solo vias oficiales" y solo entran cuando la via oficial no esta disponible.
# Cubren Idealista y, sobre todo, Fotocasa, que no tiene lectura oficial.
# RapidAPI da una clave por aplicacion y lo normal es tener una por API:
# RAPIDAPI_KEY es el respaldo comun y RAPIDAPI_KEYS permite una por fuente.
# Una variable por API, que es la forma recomendada: un secreto con su nombre
# y sin listas donde un espacio de mas deja una fuente sin clave en silencio.
IDEALISTA17_KEY=
IDEALISTA_API1_KEY=
FOTOCASA_KEY=
# Respaldo comun para las que no tengan la suya.
RAPIDAPI_KEY=
# Formato antiguo. Se mantiene por compatibilidad pero va el ultimo; si tienes
# las variables de arriba, quitalo.
#   RAPIDAPI_KEYS=rapidapi_idealista17=clave-de-esa-api,rapidapi_fotocasa=otra
RAPIDAPI_KEYS=
# Solo si el proveedor cambia de host o de ruta, sin tocar codigo:
#   RAPIDAPI_HOSTS=rapidapi_idealista17=idealista17.p.rapidapi.com
#   RAPIDAPI_PATHS=rapidapi_idealista17=/property-search-by-coordinates
RAPIDAPI_HOSTS=
RAPIDAPI_PATHS=
# Valores sueltos de parametros que cambian entre revendedores:
#   RAPIDAPI_PARAMS=rapidapi_idealista17.property_type=homes
RAPIDAPI_PARAMS=

# ---- Opcionales: datos de alquiler turistico ----
AIRROI_API_KEY=

# ---- Identificacion requerida por las politicas de uso de OSM/Nominatim ----
CONTACT_EMAIL=tu-email@ejemplo.com

# ---- Fotos reales de los modelos prefabricados ----
# Se suben con POST /api/prefab-models/<modelo>/image y se guardan aqui.
# En Fly apunta al volumen para que sobrevivan a los despliegues.
MODEL_IMAGES_DIR=data/model_images
# Alternativa: enlazar una URL externa sobre la que tengas derechos
#   PREFAB_IMAGES=plegable-40-2dorm=https://midominio/foto.jpg
PREFAB_IMAGES=

# INFO registra cada peticion con su duracion; DEBUG anade las salientes.
LOG_LEVEL=INFO

APP_ENV=production
